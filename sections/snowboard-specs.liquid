{%- if product.type == 'snowboard' -%}
  {%- assign mf = product.metafields.custom -%}
  {%- assign has_specs = false -%}
  {%- if mf.snowboard_board_type != blank
      or mf.snowboard_length != blank
      or mf.snowboard_flex_rating != blank
      or mf.snowboard_profile != blank
      or mf.snowboard_core_material != blank
      or mf.snowboard_base != blank
      or mf.snowboard_skill_level != blank
      or mf.snowboard_terrain != blank -%}
    {%- assign has_specs = true -%}
  {%- endif -%}

  {%- if has_specs -%}
    <section class="snowboard-specs">
      <div class="page-width snowboard-specs__inner">

        <div class="snowboard-specs__header">
          <div class="snowboard-specs__eyebrow">
            <span class="snowboard-specs__eyebrow-label">What's Inside</span>
            <span class="snowboard-specs__eyebrow-line"></span>
          </div>
          <h2 class="snowboard-specs__title">
            {{ product.title }} <em>Specs</em>
          </h2>
          {%- if product.description != blank -%}
            <p class="snowboard-specs__subtitle">Complete snowboard variants. Pre-tuned, waxed, and ready to ride.</p>
          {%- endif -%}
        </div>

        <div class="snowboard-specs__grid">
          {%- if mf.snowboard_board_type != blank -%}
            <div class="snowboard-specs__card">
              <h4 class="snowboard-specs__card-title">Board Type</h4>
              <p class="snowboard-specs__card-value">{{ mf.snowboard_board_type.value }}</p>
            </div>
          {%- endif -%}
          {%- if mf.snowboard_length != blank -%}
            <div class="snowboard-specs__card">
              <h4 class="snowboard-specs__card-title">Length</h4>
              <p class="snowboard-specs__card-value">{{ mf.snowboard_length.value }}</p>
            </div>
          {%- endif -%}
          {%- if mf.snowboard_flex_rating != blank -%}
            <div class="snowboard-specs__card">
              <h4 class="snowboard-specs__card-title">Flex Rating</h4>
              <p class="snowboard-specs__card-value">{{ mf.snowboard_flex_rating.value }}</p>
            </div>
          {%- endif -%}
          {%- if mf.snowboard_profile != blank -%}
            <div class="snowboard-specs__card">
              <h4 class="snowboard-specs__card-title">Profile</h4>
              <p class="snowboard-specs__card-value">{{ mf.snowboard_profile.value }}</p>
            </div>
          {%- endif -%}
          {%- if mf.snowboard_core_material != blank -%}
            <div class="snowboard-specs__card">
              <h4 class="snowboard-specs__card-title">Core Material</h4>
              <p class="snowboard-specs__card-value">{{ mf.snowboard_core_material.value }}</p>
            </div>
          {%- endif -%}
          {%- if mf.snowboard_base != blank -%}
            <div class="snowboard-specs__card">
              <h4 class="snowboard-specs__card-title">Base</h4>
              <p class="snowboard-specs__card-value">{{ mf.snowboard_base.value }}</p>
            </div>
          {%- endif -%}
          {%- if mf.snowboard_skill_level != blank -%}
            <div class="snowboard-specs__card">
              <h4 class="snowboard-specs__card-title">Skill Level</h4>
              <p class="snowboard-specs__card-value">{{ mf.snowboard_skill_level.value }}</p>
            </div>
          {%- endif -%}
          {%- if mf.snowboard_terrain != blank -%}
            <div class="snowboard-specs__card">
              <h4 class="snowboard-specs__card-title">Terrain</h4>
              <p class="snowboard-specs__card-value">{{ mf.snowboard_terrain.value }}</p>
            </div>
          {%- endif -%}
        </div>

      </div>
    </section>

    <style>
      .snowboard-specs {
        background-color: #f8f9fa;
        padding: 5rem 0;
        margin-top: 3rem;
        border-top: 1px solid #e5e7eb;
      }

      .snowboard-specs__inner {
        max-width: var(--page-width, 1200px);
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      .snowboard-specs__header {
        margin-bottom: 3rem;
      }

      .snowboard-specs__eyebrow {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 0.5rem;
      }

      .snowboard-specs__eyebrow-label {
        font-size: 0.6875rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        color: #B91C1C;
      }

      .snowboard-specs__eyebrow-line {
        display: block;
        width: 3rem;
        height: 1px;
        background-color: #B91C1C;
      }

      .snowboard-specs__title {
        font-size: clamp(2rem, 5vw, 3.5rem);
        font-weight: 500;
        line-height: 1.1;
        color: #121212;
        margin: 0 0 1.5rem 0;
      }

      .snowboard-specs__title em {
        font-family: 'Playfair Display', Georgia, serif;
        font-style: italic;
        color: #B91C1C;
      }

      .snowboard-specs__subtitle {
        color: #6b7280;
        font-size: 1rem;
        margin: 0;
        max-width: 48ch;
      }

      .snowboard-specs__grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
      }

      @media screen and (min-width: 750px) {
        .snowboard-specs__grid {
          grid-template-columns: repeat(4, 1fr);
        }
      }

      .snowboard-specs__card {
        background-color: #ffffff;
        padding: 1.5rem;
        border: 1px solid #e5e7eb;
        border-radius: 2px;
      }

      .snowboard-specs__card-title {
        font-size: 1.1rem;
        font-weight: 500;
        color: #121212;
        margin: 0 0 0.25rem 0;
      }

      .snowboard-specs__card-value {
        font-size: 0.75rem;
        color: #6b7280;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin: 0;
      }
    </style>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Snowboard Specs",
  "settings": []
}
{% endschema %}
