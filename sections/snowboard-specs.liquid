{%- if product.type == 'snowboard' -%}
  {%- comment -%} Check if at least one variant has any spec metafield filled in {%- endcomment -%}
  {%- assign has_any_variant_specs = false -%}
  {%- for variant in product.variants -%}
    {%- assign v_mf = variant.metafields.custom -%}
    {%- if v_mf.snowboard_board_type != blank or v_mf.snowboard_length != blank or v_mf.snowboard_flex_rating != blank or v_mf.snowboard_profile != blank or v_mf.snowboard_core_material != blank or v_mf.snowboard_base != blank or v_mf.snowboard_skill_level != blank or v_mf.snowboard_terrain != blank -%}
      {%- assign has_any_variant_specs = true -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if has_any_variant_specs -%}
    {%- assign selected_id = product.selected_or_first_available_variant.id -%}
    <section class="snowboard-specs"
             data-section-id="{{ section.id }}"
             data-initial-variant="{{ selected_id }}">
      <div class="page-width snowboard-specs__inner">

        <div class="snowboard-specs__header">
          <div class="snowboard-specs__eyebrow">
            <span class="snowboard-specs__eyebrow-label">What's Inside</span>
            <span class="snowboard-specs__eyebrow-line"></span>
          </div>
          <h2 class="snowboard-specs__title">
            {{ product.title }}
            <em>Specs</em>
          </h2>
          <p class="snowboard-specs__subtitle">Complete snowboard variants. Pre-tuned, waxed, and ready to ride.</p>
        </div>

        {%- for variant in product.variants -%}
          {%- assign v_mf = variant.metafields.custom -%}
          <div class="snowboard-specs__grid"
               data-variant-id="{{ variant.id }}"
               {% if variant.id != selected_id %}style="display:none;" aria-hidden="true"{% endif %}>
            {%- if v_mf.snowboard_board_type != blank -%}
              <div class="snowboard-specs__card">
                <h3 class="snowboard-specs__card-title">Board Type</h3>
                <p class="snowboard-specs__card-value">{{ v_mf.snowboard_board_type.value }}</p>
              </div>
            {%- endif -%}
            {%- if v_mf.snowboard_length != blank -%}
              <div class="snowboard-specs__card">
                <h3 class="snowboard-specs__card-title">Length</h3>
                <p class="snowboard-specs__card-value">{{ v_mf.snowboard_length.value }}</p>
              </div>
            {%- endif -%}
            {%- if v_mf.snowboard_flex_rating != blank -%}
              <div class="snowboard-specs__card">
                <h3 class="snowboard-specs__card-title">Flex Rating</h3>
                <p class="snowboard-specs__card-value">{{ v_mf.snowboard_flex_rating.value }}</p>
              </div>
            {%- endif -%}
            {%- if v_mf.snowboard_profile != blank -%}
              <div class="snowboard-specs__card">
                <h3 class="snowboard-specs__card-title">Profile</h3>
                <p class="snowboard-specs__card-value">{{ v_mf.snowboard_profile.value }}</p>
              </div>
            {%- endif -%}
            {%- if v_mf.snowboard_core_material != blank -%}
              <div class="snowboard-specs__card">
                <h3 class="snowboard-specs__card-title">Core Material</h3>
                <p class="snowboard-specs__card-value">{{ v_mf.snowboard_core_material.value }}</p>
              </div>
            {%- endif -%}
            {%- if v_mf.snowboard_base != blank -%}
              <div class="snowboard-specs__card">
                <h3 class="snowboard-specs__card-title">Base</h3>
                <p class="snowboard-specs__card-value">{{ v_mf.snowboard_base.value }}</p>
              </div>
            {%- endif -%}
            {%- if v_mf.snowboard_skill_level != blank -%}
              <div class="snowboard-specs__card">
                <h3 class="snowboard-specs__card-title">Skill Level</h3>
                <p class="snowboard-specs__card-value">{{ v_mf.snowboard_skill_level.value }}</p>
              </div>
            {%- endif -%}
            {%- if v_mf.snowboard_terrain != blank -%}
              <div class="snowboard-specs__card">
                <h3 class="snowboard-specs__card-title">Terrain</h3>
                <p class="snowboard-specs__card-value">{{ v_mf.snowboard_terrain.value }}</p>
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}

      </div>
    </section>

    <style>
      .snowboard-specs {
        background-color: #f8f9fa;
        padding: 5rem 0;
        margin-top: 3rem;
        border-top: 1px solid #e5e7eb;
        font-family: 'Lora'
        , Georgia
        , serif;
      }

      .snowboard-specs__inner {
        max-width: var(--page-width, 1200px);
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      .snowboard-specs__header {
        margin-bottom: 3rem;
      }

      .snowboard-specs__eyebrow {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 0.5rem;
      }

      .snowboard-specs__eyebrow-label {
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        color: #8B0000;
        @media (min-width: 750px) {
          font-size: 1rem;
        }
      }

      .snowboard-specs__eyebrow-line {
        display: block;
        width: 3rem;
        height: 1px;
        background-color: #8B0000;
      }

      .snowboard-specs__title {
        font-size: clamp(2rem, 5vw, 3.5rem);
        font-weight: 700;
        line-height: 1.1;
        color: #121212;
        margin: 0 0 1.5rem;
      }

      .snowboard-specs__title em {
        font-family: 'Lora'
        , Georgia
        , serif;
        color: #8B0000;
      }

      .snowboard-specs__subtitle {
        color: #121212;
        font-size: 1.2rem;
        margin: 0;
        font-family: 'DM Sans'
        , Arial
        , sans-serif;
      }

      .snowboard-specs__grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
      }

      @media screen and (min-width: 750px) {
        .snowboard-specs__grid {
          grid-template-columns: repeat(4, 1fr);
        }
      }

      .snowboard-specs__card {
        background-color: #ffffff;
        padding: 1.5rem;
        border: 1px solid #e5e7eb;
        border-radius: 2px;
        transition: transform 0.15s ease-in, box-shadow 0.15s ease-in, border-color 0.15s ease-in;
      }

      .snowboard-specs__card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
        border-color: #8B0000;
        transition: transform 0.2s ease-out, box-shadow 0.2s ease-out, border-color 0.2s ease-out;
      }

      .snowboard-specs__card-title {
        font-size: 1.6rem;
        font-weight: 600;
        font-family: 'Lora'
        , Georgia
        , serif;
        color: #000000;
        margin: 0 0 0.25rem;
        transition: color 0.15s ease-in;
        @media (min-width: 750px) {
          font-size: 2.4rem;
        }
      }

      .snowboard-specs__card:hover .snowboard-specs__card-title {
        color: #8B0000;
        transition: color 0.2s ease-out;
      }

      .snowboard-specs__card-value {
        font-family: 'DM Sans'
        , Arial
        , sans-serif;
        font-size: 0.75rem;
        color: #000000;
        letter-spacing: 0.08em;
        margin: 0;
        @media(min-width: 750px) {
          font-size: 1.2rem;
        }
      }

      @keyframes specs-card-in {
        from { opacity: 0; transform: translateY(18px); }
        to   { opacity: 1; transform: translateY(0); }
      }

      .snowboard-specs__card--enter {
        animation: specs-card-in 0.45s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }

      @media (prefers-reduced-motion: reduce) {
        .snowboard-specs__card,
        .snowboard-specs__card:hover {
          transition: none;
          transform: none;
          box-shadow: none;
        }
        .snowboard-specs__card-title {
          transition: none;
        }
      }
    </style>

    <script>
      (function () {
        var section = document.querySelector('.snowboard-specs[data-section-id="{{ section.id }}"]');
        if (!section) return;

        var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        function animateCards(grid) {
          if (reducedMotion) return;
          var cards = grid.querySelectorAll('.snowboard-specs__card');
          cards.forEach(function (card, i) {
            card.style.opacity = '0';
            setTimeout(function () {
              card.classList.add('snowboard-specs__card--enter');
              card.addEventListener('animationend', function () {
                card.classList.remove('snowboard-specs__card--enter');
                card.style.opacity = '';
              }, { once: true });
            }, i * 60);
          });
        }

        // Scroll-triggered entry animation for the initially selected variant grid
        if (!reducedMotion && window.IntersectionObserver) {
          var initialVariantId = section.dataset.initialVariant;
          var initialGrid = section.querySelector('.snowboard-specs__grid[data-variant-id="' + initialVariantId + '"]');
          if (initialGrid) {
            initialGrid.querySelectorAll('.snowboard-specs__card').forEach(function (c) {
              c.style.opacity = '0';
            });
            var observer = new IntersectionObserver(function (entries) {
              if (entries[0].isIntersecting) {
                observer.disconnect();
                animateCards(initialGrid);
              }
            }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
            observer.observe(initialGrid);
          }
        }

        // On variant change: swap the visible grid and animate the new cards in
        document.addEventListener('variant:change', function (e) {
          if (!e.detail || !e.detail.variant) return;
          var variantId = String(e.detail.variant.id);
          section.querySelectorAll('.snowboard-specs__grid[data-variant-id]').forEach(function (grid) {
            if (grid.dataset.variantId === variantId) {
              grid.style.display = '';
              grid.removeAttribute('aria-hidden');
              animateCards(grid);
            } else {
              grid.style.display = 'none';
              grid.setAttribute('aria-hidden', 'true');
            }
          });
        });
      })();
    </script>
  {%- endif -%}
{%- endif -%}

{% schema %}
  {
    "name": "Snowboard Specs",
    "settings": []
  }
{% endschema %}
